[Unit]
Description=AI Trend Hunter & Viral Thread Architect Backend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/trendhunter-backend
ExecStart=/usr/bin/python3 /root/trendhunter-backend/trendhunter_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
